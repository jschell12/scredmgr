{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scredmanager",
  "version": "0.1.0",
  "identifier": "com.jschell12.scredmanager.gui",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "scredmanager",
        "width": 780,
        "height": 620,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
